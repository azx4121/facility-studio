             ${{ runner.temp }}/facility-second-evidence
             ${{ runner.temp }}/facility-second-installer/evidence
           retention-days: 14
+  native-macos:
+    needs: numerical-and-native-tk-source
+    runs-on: macos-15
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.10'
+      - name: Install managed Python 3.12.16 and locked dependencies
+        run: |
+          python -m pip install uv==0.13.6
+          export UV_PYTHON_INSTALL_DIR="$RUNNER_TEMP/facility-managed-python"
+          uv venv --python 3.12.16 "$RUNNER_TEMP/facility-env"
+          uv pip install --python "$RUNNER_TEMP/facility-env/bin/python" -r integration/requirements.lock.txt
+          uv pip check --python "$RUNNER_TEMP/facility-env/bin/python"
+          echo "FACILITY_PY=$RUNNER_TEMP/facility-env/bin/python" >> "$GITHUB_ENV"
+      - name: Native macOS Tk source tests for review-draft close guard and FEED pages
+        env:
+          MPLBACKEND: Agg
+        run: |
+          mkdir -p "$RUNNER_TEMP/mac-evidence"
+          "$FACILITY_PY" -m pytest integration/test_design_basis.py integration/test_design_basis_gui.py integration/test_pump_suction.py integration/test_release_identity.py integration/test_product_wording.py -q --junitxml="$RUNNER_TEMP/mac-evidence/pytest.xml"
+          FACILITY_STUDIO_FUSION_DATA="$RUNNER_TEMP/mac-source-data" FACILITY_TEST_BLOCK_NETWORK=1 PYTHONPATH=macos "$FACILITY_PY" integration/entry.py --facilities-self-test "$RUNNER_TEMP/mac-evidence/Native_GUI_source.json"
+      - name: Build, sign and run packaged acceptance
+        run: '"$FACILITY_PY" integration/build.py --output "$RUNNER_TEMP/facility-build"'
+      - name: Relocated offline acceptance without development Python
+        run: |
+          set -euo pipefail
+          cd "$RUNNER_TEMP/facility-build"
+          shasum -a 256 -c SHA256SUMS.txt
+          zip=$(ls Facility-Studio-5.7.2-macOS-arm64.zip)
+          dest="$RUNNER_TEMP/relocated/新位置"
+          mkdir -p "$dest"
+          /usr/bin/ditto -x -k "$zip" "$dest"
+          app="$dest/Facility Studio 5.7.2 測試版.app"
+          /usr/bin/codesign --verify --deep --strict "$app"
+          /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" | tee "$RUNNER_TEMP/mac-evidence/bundle-id.txt"
+          grep -qx 'com.facilitystudio.preview572' "$RUNNER_TEMP/mac-evidence/bundle-id.txt"
+          mkdir -p "$RUNNER_TEMP/empty-cwd" "$RUNNER_TEMP/empty-home"
+          cd "$RUNNER_TEMP/empty-cwd"
+          for kind in fusion facilities; do
+            env -i HOME="$RUNNER_TEMP/empty-home" PATH=/usr/bin:/bin TMPDIR="$RUNNER_TEMP" \
+              FACILITY_TEST_BLOCK_NETWORK=1 FACILITY_STUDIO_FUSION_DATA="$RUNNER_TEMP/relocated-data" \
+              "$app/Contents/MacOS/Facility Studio 5.7.2 測試版" --$kind-self-test "$RUNNER_TEMP/mac-evidence/relocated-$kind.json"
+            "$FACILITY_PY" -c "import json,sys; d=json.load(open(sys.argv[1],encoding='utf-8')); assert d['passed'] and d['frozen'] and d['version']=='5.7.2-preview.1', d; print(sys.argv[1], len(d['checks']), 'checks passed')" "$RUNNER_TEMP/mac-evidence/relocated-$kind.json"
+          done
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        if: always()
+        with:
+          name: facility-studio-macOS-evidence
+          path: |
+            ${{ runner.temp }}/mac-evidence
+            ${{ runner.temp }}/facility-build/evidence
+          retention-days: 14
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: facility-studio-macOS-delivery
+          path: |
+            ${{ runner.temp }}/facility-build/*.zip
+            ${{ runner.temp }}/facility-build/SHA256SUMS.txt
+          if-no-files-found: error
+          retention-days: 14
