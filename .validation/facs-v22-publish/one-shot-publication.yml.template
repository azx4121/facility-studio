# LOCAL TEMPLATE ONLY. Render only after all final acceptance/pixel inspection.
# Replaces this file only in ONE activation commit A whose sole parent is the
# exact reviewed publisher C. Create branch validation/facs-v22-publish-<A> only
# after independently reading and verifying A and its four changed files.
name: Exact-SHA one-shot verified Windows publication
on:
  push:
    branches: ['validation/facs-v22-publish-*']
    paths:
      - '.github/workflows/private-windows-handoff.yml'
      - '.validation/facs-v22-publish/one-shot-lock.json'
      - '.validation/facs-v22-publish/one-shot-pixel-inspection.json'
      - '.validation/facs-v22-publish/one-shot-invocation.json'
permissions:
  contents: read
concurrency:
  group: facs-v22-one-time-final-windows
  cancel-in-progress: false
jobs:
  verify-same-bytes-2025:
    if: github.repository == 'azx4121/facility-studio' && github.event_name == 'push' && github.ref == format('refs/heads/validation/facs-v22-publish-{0}', github.sha) && github.run_attempt == 1
    runs-on: windows-2025
    timeout-minutes: 40
    permissions:
      contents: write
      actions: read
    env:
      PYTHONUTF8: '1'
      PYTHONDONTWRITEBYTECODE: '1'
      FACS_EXPECTED_PUBLISHER_COMMIT: 'REPLACE_PUBLISHER_COMMIT'
      PUBLICATION_LOCK_SHA256: 'REPLACE_LOCK_SHA256'
      PUBLICATION_REVIEW_SHA256: 'REPLACE_REVIEW_SHA256'
      PUBLICATION_INVOCATION_SHA256: 'REPLACE_INVOCATION_SHA256'
      PUBLICATION_OPERATION: 'REPLACE_OPERATION'
      PUBLICATION_RESUME_ID: 'REPLACE_RESUME_ID'
      FACS_RELEASE_LOCK: ${{ github.workspace }}/.validation/facs-v22-publish/one-shot-lock.json
      FACS_RELEASE_REVIEW: ${{ github.workspace }}/.validation/facs-v22-publish/one-shot-pixel-inspection.json
      FACS_RELEASE_INVOCATION: ${{ github.workspace }}/.validation/facs-v22-publish/one-shot-invocation.json
    steps:
      - name: Initialize runner-temp evidence path
        shell: pwsh
        run: |
          "FACS_RELEASE_EVIDENCE=$env:RUNNER_TEMP/facs-final-evidence-$env:GITHUB_RUN_ID" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        env:
          # Scope newline settings to checkout, before any repository bytes land.
          GIT_CONFIG_COUNT: '2'
          GIT_CONFIG_KEY_0: core.autocrlf
          GIT_CONFIG_VALUE_0: 'false'
          GIT_CONFIG_KEY_1: core.eol
          GIT_CONFIG_VALUE_1: lf
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12.10'
      - name: Offline publication and exact-activation guard tests
        run: python -B -m unittest discover -s .validation/facs-v22-publish -p 'test_*.py' -v
      - name: Verify exact activation context and fetch pinned successful diagnostics
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python -B .validation/facs-v22-publish/publish_verified_windows.py fetch-evidence --lock "$env:FACS_RELEASE_LOCK" --lock-sha256 "$env:PUBLICATION_LOCK_SHA256" --review "$env:FACS_RELEASE_REVIEW" --one-shot-invocation "$env:FACS_RELEASE_INVOCATION" --invocation-sha256 "$env:PUBLICATION_INVOCATION_SHA256" --evidence-root "$env:FACS_RELEASE_EVIDENCE"
          if ($LASTEXITCODE -ne 0) { throw 'Activation or successful diagnostic-read gate failed; no publication' }
      - name: Check full evidence and actual AI or human pixel inspection without token
        shell: pwsh
        run: |
          python -B .validation/facs-v22-publish/publish_verified_windows.py offline --lock "$env:FACS_RELEASE_LOCK" --lock-sha256 "$env:PUBLICATION_LOCK_SHA256" --review "$env:FACS_RELEASE_REVIEW" --review-sha256 "$env:PUBLICATION_REVIEW_SHA256" --evidence-root "$env:FACS_RELEASE_EVIDENCE"
          if ($LASTEXITCODE -ne 0) { throw 'Evidence or sixteen-image pixel inspection failed; no publication' }
      - name: Execute only the pinned single-use operation on exact tested bytes
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if ($env:PUBLICATION_OPERATION -notin @('preflight', 'publish', 'inspect', 'verify-public', 'stage-existing')) { throw 'Unsupported operation' }
          $arguments = @('-B', '.validation/facs-v22-publish/publish_verified_windows.py', $env:PUBLICATION_OPERATION, '--lock', $env:FACS_RELEASE_LOCK, '--lock-sha256', $env:PUBLICATION_LOCK_SHA256, '--review', $env:FACS_RELEASE_REVIEW, '--review-sha256', $env:PUBLICATION_REVIEW_SHA256, '--evidence-root', $env:FACS_RELEASE_EVIDENCE, '--one-shot-invocation', $env:FACS_RELEASE_INVOCATION, '--invocation-sha256', $env:PUBLICATION_INVOCATION_SHA256)
          if ($env:PUBLICATION_RESUME_ID) {
            if ($env:PUBLICATION_RESUME_ID -notmatch '^[1-9][0-9]*$') { throw 'Invalid explicitly inspected release ID' }
            $arguments += @('--release-id', $env:PUBLICATION_RESUME_ID)
          }
          & python @arguments
          if ($LASTEXITCODE -ne 0) { throw 'Stopped. Inspect exact release/asset IDs. Do not rerun, replace, or delete.' }
# No application execution, rebuild, upload-artifact, default-branch write,
# private-candidate modification, external credentials, or automatic retry.
# Parent must replace this workflow with one-shot-retired.yml.template promptly
# after outcome inspection. Retire the old private-transfer branch writer too.
# Any later push has SHA != the pinned branch suffix and cannot enter this job.
